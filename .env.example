# Browser execution: use installed Playwright Chromium unless a trusted local binary is explicitly set
# PLAYWRIGHT_CHROMIUM_EXECUTABLE=/usr/bin/chromium
# Authorized proxy only. This demo deliberately excludes anti-bot/fingerprint evasion.
# AUTHORIZED_PROXY_SERVER=http://your-approved-proxy:8080
# AUTHORIZED_PROXY_USERNAME=
# AUTHORIZED_PROXY_PASSWORD=
# Explicit allowlist for authorized external domains. Localhost is allowed by default.
# ALLOWED_TARGET_HOSTS=localhost,127.0.0.1,approved.example
# Optional private Dropbox upload (requires valid OAuth token and existing authorized folder)
# DROPBOX_ACCESS_TOKEN=
# DROPBOX_FOLDER=/Apps/EventWatchDemo
